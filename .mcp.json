{
  "mcpServers": {
    "gitlab": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "mcp-remote@^0.1.16",
        "https://gitlab.com/api/v4/mcp"
      ]
    },
    "github": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(/opt/homebrew/bin/op read 'op://Engineering/3wawtjaiumpz54thmqqsfvqafq/credential' --account gifteddreamers) /opt/homebrew/bin/npx -y @modelcontextprotocol/server-github"
      ]
    },
    "n8n": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "N8N_API_KEY=$(/opt/homebrew/bin/op read 'op://Engineering/6amq5ivuilems7ztihhmmywj6u/credential' --account gifteddreamers) /opt/homebrew/bin/npx -y n8n-mcp"
      ],
      "env": {
        "N8N_API_URL": "https://n8n.cloudpublica.org/",
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error"
      }
    },
    "n8n-instance": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "/opt/homebrew/bin/npx -y mcp-remote@^0.1.16 https://n8n.cloudpublica.org/mcp-server/http --header \"Authorization: Bearer $(/opt/homebrew/bin/op read 'op://Engineering/luooictav42nw563febxtes7my/credential' --account gifteddreamers)\""
      ]
    },
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ]
    },
    "awslabs.aws-api-mcp-server": {
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1"
      }
    },
    "awslabs.aws-documentation-mcp-server": {
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "airtable": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "AIRTABLE_API_KEY=$(/opt/homebrew/bin/op read 'op://Engineering/jgwgyimza4rxuv65vgdem3qncm/credential' --account gifteddreamers) /opt/homebrew/bin/npx -y airtable-mcp-server"
      ]
    },
    "datadog": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "/opt/homebrew/bin/npx -y datadog-mcp-server --apiKey $(/opt/homebrew/bin/op read 'op://Engineering/uz6h66b7bdr4agonobs3go647i/credential' --account gifteddreamers) --appKey $(/opt/homebrew/bin/op read 'op://Engineering/pn34fczjce5egcru2wqcc4eksy/credential' --account gifteddreamers) --site us5.datadoghq.com"
      ]
    }
  }
}
